# ~/.themes/blackbeard-light/gtk-2.0/gtkrc

# Color Definitions (for reference)
# bg            #F4E3C1
# fg            #1C1B1A
# cursor        #D13438
# selection_bg  #F4A259
# selection_fg  #1C1B1A
# black         #3A3735
# red           #8B1A1E
# green         #4A7C2A
# yellow        #A67F20
# blue          #2A5A75
# magenta       #6A3A8A
# cyan          #2A5A75
# white         #6A5E47
# brblack       #514A45
# brred         #A71A1D
# brgreen       #5A8C3A
# bryellow      #C89F27
# brblue        #3A6A85
# brmagenta     #8A5AB4
# brcyan        #3A6A85
# brwhite       #C9B999

# Global Style
style "default"
{
  bg[NORMAL]      = "#F4E3C1"
  bg[PRELIGHT]    = "#F4E3C1"
  bg[ACTIVE]      = "#3A3735"
  bg[SELECTED]    = "#F4A259"
  bg[INSENSITIVE] = "#514A45"

  fg[NORMAL]      = "#1C1B1A"
  fg[PRELIGHT]    = "#1C1B1A"
  fg[ACTIVE]      = "#1C1B1A"
  fg[SELECTED]    = "#1C1B1A"
  fg[INSENSITIVE] = "#6A5E47"

  base[NORMAL]    = "#F4E3C1"
  base[PRELIGHT]  = "#F4E3C1"
  base[ACTIVE]    = "#F4A259"
  base[SELECTED]  = "#F4A259"
  base[INSENSITIVE] = "#3A3735"

  text[NORMAL]    = "#1C1B1A"
  text[PRELIGHT]  = "#1C1B1A"
  text[ACTIVE]    = "#1C1B1A"
  text[SELECTED]  = "#1C1B1A"
  text[INSENSITIVE] = "#6A5E47"

  # Engine tweaks (optional, depends on installed theme engine like Clearlooks)
  engine "clearlooks" {
    roundness = 1
    gradient_shades = {1.0, 0.9, 0.8}
  }
}
class "*" style "default"

# Window Background
style "window"
{
  bg[NORMAL] = "#F4E3C1"
  bg[INSENSITIVE] = "#514A45"
}
widget_class "*<GtkWindow>" style "window"

# Buttons
style "button"
{
  bg[NORMAL]   = "#2A5A75"
  bg[PRELIGHT] = "#3A6A85"
  bg[ACTIVE]   = "#2A5A75"
  bg[INSENSITIVE] = "#514A45"
  fg[NORMAL]   = "#1C1B1A"
  fg[INSENSITIVE] = "#6A5E47"
  xthickness = 4
  ythickness = 4
}
widget_class "*<GtkButton>" style "button"

# Entries
style "entry"
{
  bg[NORMAL]   = "#F4E3C1"
  bg[INSENSITIVE] = "#3A3735"
  fg[NORMAL]   = "#1C1B1A"
  fg[INSENSITIVE] = "#6A5E47"
  base[NORMAL] = "#F4E3C1"
  base[INSENSITIVE] = "#3A3735"
  text[NORMAL] = "#1C1B1A"
  text[INSENSITIVE] = "#6A5E47"
  xthickness = 2
  ythickness = 2
}
widget_class "*<GtkEntry>" style "entry"

# Menu
style "menu"
{
  bg[NORMAL] = "#F4E3C1"
  bg[INSENSITIVE] = "#3A3735"
  fg[NORMAL] = "#1C1B1A"
  fg[INSENSITIVE] = "#6A5E47"
}
widget_class "*<GtkMenu>" style "menu"

style "menuitem"
{
  bg[PRELIGHT] = "#3A3735"
  fg[PRELIGHT] = "#1C1B1A"
  bg[INSENSITIVE] = "#3A3735"
  fg[INSENSITIVE] = "#6A5E47"
}
widget_class "*<GtkMenuItem>" style "menuitem"

# Scrollbars
style "scrollbar"
{
  bg[NORMAL]   = "#F4E3C1"
  bg[PRELIGHT] = "#3A6A85"
  bg[ACTIVE]   = "#2A5A75"
  bg[INSENSITIVE] = "#514A45"
  xthickness = 6
  ythickness = 6
}
widget_class "*<GtkScrollbar>" style "scrollbar"

# Tooltips
style "tooltip"
{
  bg[NORMAL] = "#3A3735"
  fg[NORMAL] = "#1C1B1A"
  bg[INSENSITIVE] = "#514A45"
  fg[INSENSITIVE] = "#6A5E47"
}
widget_class "*<GtkTooltip>" style "tooltip"

# Progress Bar
style "progressbar"
{
  bg[NORMAL]   = "#F4E3C1"
  fg[NORMAL]   = "#4A7C2A"
  bg[INSENSITIVE] = "#514A45"
  fg[INSENSITIVE] = "#5A8C3A"
}
widget_class "*<GtkProgressBar>" style "progressbar"

# Notebook (Tabs)
style "notebook"
{
  bg[NORMAL]   = "#F4E3C1"
  bg[ACTIVE]   = "#2A5A75"
  fg[NORMAL]   = "#1C1B1A"
  bg[INSENSITIVE] = "#514A45"
  fg[INSENSITIVE] = "#6A5E47"
  xthickness = 4
  ythickness = 4
}
widget_class "*<GtkNotebook>" style "notebook"

# Scales (Sliders)
style "scale"
{
  bg[NORMAL]   = "#514A45"
  fg[NORMAL]   = "#2A5A75"
  bg[PRELIGHT] = "#3A6A85"
  bg[ACTIVE]   = "#4A7C2A"
  bg[INSENSITIVE] = "#3A3735"
  xthickness = 4
  ythickness = 4
}
widget_class "*<GtkScale>" style "scale"

# Spinbuttons
style "spinbutton"
{
  bg[NORMAL]   = "#F4E3C1"
  fg[NORMAL]   = "#1C1B1A"
  bg[INSENSITIVE] = "#3A3735"
  fg[INSENSITIVE] = "#6A5E47"
  xthickness = 2
  ythickness = 2
}
widget_class "*<GtkSpinButton>" style "spinbutton"

# Combobox
style "combobox"
{
  bg[NORMAL]   = "#F4E3C1"
  fg[NORMAL]   = "#1C1B1A"
  bg[INSENSITIVE] = "#3A3735"
  fg[INSENSITIVE] = "#6A5E47"
  xthickness = 2
  ythickness = 2
}
widget_class "*<GtkComboBox>" style "combobox"
